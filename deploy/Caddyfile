# Serves the static export (out/) as the site expects: each route is a directory with an
# index.html, /en redirects to /en/, and a missing path gets 404.html with status 404.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header X-Content-Type-Options nosniff
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
	@html path / */ *.html
	header @html Cache-Control no-cache

	file_server

	handle_errors 404 {
		header Cache-Control no-cache
		rewrite * /404.html
		file_server
	}
}
